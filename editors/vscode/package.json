{
  "name": "grebe",
  "displayName": "grebe — DuckDB SQL",
  "description": "DuckDB SQL in the editor: lint, quick fixes and formatting, plus running SQL with your own duckdb CLI, a results grid, a catalog, and Parquet and CSV files in the grid.",
  "publisher": "ncrzw9",
  "version": "0.99.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ncrzw9/grebe"
  },
  "bugs": {
    "url": "https://github.com/ncrzw9/grebe/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Linters",
    "Formatters",
    "Programming Languages",
    "Data Science"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:sql"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode grebe lints and formats SQL. Running SQL, the Catalog and data files need a trusted folder, and the folder's own grebe.path, grebe.duckdb.path and grebe.duckdb.database settings are not used until then.",
      "restrictedConfigurations": [
        "grebe.path",
        "grebe.duckdb.path",
        "grebe.duckdb.database"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "grebe runs local programs (its language server and the duckdb CLI) on local files."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "grebe.restart",
        "title": "Restart Server",
        "category": "grebe"
      },
      {
        "command": "grebe.showOutput",
        "title": "Show Output",
        "category": "grebe"
      },
      {
        "command": "grebe.friendly",
        "title": "Rewrite as Friendly SQL",
        "category": "grebe"
      },
      {
        "command": "grebe.duckdb.runStatement",
        "title": "Run Statement (or Selection) with DuckDB",
        "category": "grebe",
        "icon": "$(play)"
      },
      {
        "command": "grebe.duckdb.runFile",
        "title": "Run File with DuckDB",
        "category": "grebe",
        "icon": "$(run-all)"
      },
      {
        "command": "grebe.duckdb.cancel",
        "title": "Cancel Running Query",
        "category": "grebe",
        "icon": "$(debug-stop)"
      },
      {
        "command": "grebe.duckdb.chooseDatabase",
        "title": "Choose DuckDB Database",
        "category": "grebe"
      },
      {
        "command": "grebe.duckdb.restart",
        "title": "Restart DuckDB Session",
        "category": "grebe",
        "icon": "$(debug-restart)"
      },
      {
        "command": "grebe.duckdb.resetWorkspaceDatabase",
        "title": "Delete Workspace Database",
        "category": "grebe"
      },
      {
        "command": "grebe.duckdb.runRange",
        "title": "Run This Statement with DuckDB",
        "category": "grebe"
      },
      {
        "command": "grebe.inspect.columns",
        "title": "Show Columns",
        "category": "grebe: Data file"
      },
      {
        "command": "grebe.inspect.stats",
        "title": "Show Stats (SUMMARIZE)",
        "category": "grebe: Data file"
      },
      {
        "command": "grebe.inspect.preview",
        "title": "Preview Rows",
        "category": "grebe: Data file"
      },
      {
        "command": "grebe.inspect.parquet",
        "title": "Show Parquet Metadata",
        "category": "grebe: Data file"
      },
      {
        "command": "grebe.inspect.dialect",
        "title": "Show CSV Dialect (sniff)",
        "category": "grebe: Data file"
      },
      {
        "command": "grebe.catalog.refresh",
        "title": "Refresh",
        "category": "grebe: Catalog",
        "icon": "$(refresh)"
      },
      {
        "command": "grebe.catalog.start",
        "title": "Start DuckDB Session",
        "category": "grebe: Catalog"
      },
      {
        "command": "grebe.catalog.reindex",
        "title": "Refresh Connection Index",
        "category": "grebe: Catalog",
        "icon": "$(sync)"
      },
      {
        "command": "grebe.catalog.preview",
        "title": "Preview",
        "category": "grebe: Catalog"
      },
      {
        "command": "grebe.catalog.columns",
        "title": "Show Columns",
        "category": "grebe: Catalog"
      },
      {
        "command": "grebe.catalog.stats",
        "title": "Show Stats (SUMMARIZE)",
        "category": "grebe: Catalog"
      },
      {
        "command": "grebe.catalog.count",
        "title": "Count Rows",
        "category": "grebe: Catalog"
      },
      {
        "command": "grebe.catalog.copyName",
        "title": "Copy Qualified Name",
        "category": "grebe: Catalog"
      },
      {
        "command": "grebe.catalog.insertName",
        "title": "Insert Name into Editor",
        "category": "grebe: Catalog"
      },
      {
        "command": "grebe.catalog.attach",
        "title": "Attach Database to Session…",
        "category": "grebe: Catalog",
        "icon": "$(plug)"
      },
      {
        "command": "grebe.catalog.attachPostgres",
        "title": "Attach PostgreSQL Database…",
        "category": "grebe: Catalog",
        "icon": "$(server)"
      },
      {
        "command": "grebe.catalog.detach",
        "title": "Detach",
        "category": "grebe: Catalog",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "grebe.catalog.reattach",
        "title": "Attach Again",
        "category": "grebe: Catalog",
        "icon": "$(plug)"
      },
      {
        "command": "grebe.catalog.forget",
        "title": "Forget",
        "category": "grebe: Catalog",
        "icon": "$(close)"
      },
      {
        "command": "grebe.catalog.browseFile",
        "title": "Browse DuckDB File…",
        "category": "grebe: Catalog",
        "icon": "$(folder-opened)"
      },
      {
        "command": "grebe.catalog.closeFile",
        "title": "Close",
        "category": "grebe: Catalog",
        "icon": "$(close)"
      },
      {
        "command": "grebe.catalog.useAsDatabase",
        "title": "Use as Session Database",
        "category": "grebe: Catalog"
      },
      {
        "command": "grebe.results.openInEditor",
        "title": "Open Results in Editor",
        "category": "grebe",
        "icon": "$(link-external)"
      },
      {
        "command": "grebe.results.show",
        "title": "Show Results",
        "category": "grebe"
      },
      {
        "command": "grebe.openInGrid",
        "title": "Open in Grid",
        "category": "grebe: Data file",
        "icon": "$(table)"
      }
    ],
    "configuration": {
      "title": "grebe",
      "properties": {
        "grebe.path": {
          "type": "string",
          "default": "",
          "description": "Path to the grebe executable. Leave empty to use the binary bundled with this extension, then ~/.local/bin/grebe, then grebe on PATH. A path set here is checked with `--version` before the server starts, and used without falling back."
        },
        "grebe.select": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ALL"
          ],
          "description": "The MOD rules to lint for, same as the grebe CLI's --select flag. Only the MOD rules listed here run, and any of them that are off by default are turned on. The default, [\"ALL\"], is every MOD rule there is -- including ones added after this setting, so the editor stays loud rather than needing an update to see a new rule; list codes explicitly to pick a subset instead. Parse errors (PRS) and other-dialect notices (SRC) are always shown unless set to off in grebe.toml's [severity]."
        },
        "grebe.duckdb.path": {
          "type": "string",
          "default": "",
          "description": "Path to the duckdb CLI used to run SQL (default: `duckdb` on PATH). grebe never bundles or links DuckDB; the version you point at is the version your SQL runs on."
        },
        "grebe.duckdb.database": {
          "type": "string",
          "default": ":memory:",
          "description": "Database to run SQL against: `:memory:`, `:workspace:` or a file path (relative paths resolve against the workspace folder). `:workspace:` is a database file kept in the editor's own storage for this workspace: tables survive a window reload, a restart or a crash, and nothing is added to your project. One session stays open and every file runs in it, so TEMP tables and SET options persist between runs until the session restarts. A file whose leading comment says `-- grebe: session NAME` runs in a separate session of that name."
        },
        "grebe.duckdb.reattach": {
          "type": "boolean",
          "default": true,
          "description": "When a session starts, attach again the databases it had attached when it was last used (from the Catalog or by an ATTACH in your SQL). Passwords are never kept: a server that needs one asks again. A connection you detached is not attached again until you ask; it stays in the Catalog, marked detached. Off: every connection stays listed and is attached only when you ask."
        },
        "grebe.duckdb.connections": {
          "type": "array",
          "default": [],
          "markdownDescription": "Connections the shared session always lists in the Catalog: database files and servers, by the name SQL uses for them. Each is attached when the session starts unless you detached it, and stays listed, detached, until you attach it again. Do not put a password here: one in a connection string is ignored, and the server asks when it needs one.\n\n```json\n[\n  { \"alias\": \"sales\", \"path\": \"data/sales.duckdb\" },\n  { \"alias\": \"warehouse\", \"path\": \"postgresql://me@db.example.com/warehouse\", \"type\": \"postgres\", \"readOnly\": true }\n]\n```",
          "items": {
            "type": "object",
            "required": ["alias", "path"],
            "additionalProperties": false,
            "properties": {
              "alias": { "type": "string", "description": "The name SQL uses for it: alias.table." },
              "path": { "type": "string", "description": "A database file (relative to the workspace folder, or absolute) or a connection string." },
              "type": { "type": "string", "description": "What it is when it is not a DuckDB file: postgres, sqlite, mysql, ..." },
              "readOnly": { "type": "boolean", "default": false, "description": "Attach it read-only." }
            }
          }
        },
        "grebe.duckdb.catalogInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Give the language server the tables and columns of the running session, so the editor completes their names, describes them on hover, can expand a SELECT * to its columns, and marks a table or column the session does not have. Off: completion and linting use the SQL text alone."
        },
        "grebe.duckdb.catalogIndex": {
          "type": "boolean",
          "default": true,
          "description": "Keep what the editor knows of the session database by database. Local databases (the session's own, in-memory and TEMP ones, attached DuckDB files) are read again after a run. A foreign database (PostgreSQL, SQLite, MySQL, ...) is read once, when first attached, kept between windows, and read again only when a statement changes it, when its index is older than grebe.duckdb.catalogIndexMaxAge, or when you choose Refresh Connection Index in the Catalog. A database of more than 500,000 columns is left out by itself; the others still complete and are checked. The Catalog view draws from the same index, so a refresh asks an attached database nothing, and a database is read only when you open it. Off: every database is read after every run and sent as one snapshot, and past 100,000 columns in all the editor gets none."
        },
        "grebe.duckdb.catalogIndexMaxAge": {
          "type": "integer",
          "default": 60,
          "minimum": 0,
          "description": "Read a foreign database's tables again once its index is older than this many minutes (default 60), at the next run. 0 never does by age: only a statement that changes the database, or Refresh Connection Index, reads it again. Tables created on the server by someone else show up in completion after this long at most."
        },
        "grebe.duckdb.maxRows": {
          "type": "integer",
          "default": 10000,
          "minimum": 1,
          "description": "Most rows a query shows in the grid, and read from a data file opened in the grid (default 10,000). DuckDB stops after these, so a result of millions of rows comes back as fast as one of ten thousand; Count gives the full total, and Export always writes every row."
        },
        "grebe.duckdb.queryTimeout": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Cancel a statement that runs longer than this many seconds. 0, the default, never does. A cancelled statement stops within milliseconds and the session, TEMP tables included, carries on; the rest of the run does not run."
        },
        "grebe.duckdb.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a ▶ Run link above each SQL statement."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "source.duckdb.keywords",
        "path": "./syntaxes/duckdb-keywords.injection.json",
        "injectTo": [
          "source.sql"
        ]
      }
    ],
    "keybindings": [
      {
        "command": "grebe.duckdb.runStatement",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "grebe.duckdb.runFile",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "grebe.friendly",
          "when": "editorLangId == sql && resourceScheme == file",
          "group": "1_modification@90"
        }
      ],
      "editor/title/run": [
        {
          "command": "grebe.duckdb.runStatement",
          "when": "editorLangId == sql && !grebe.duckdb.running",
          "group": "navigation@1"
        },
        {
          "command": "grebe.duckdb.runFile",
          "when": "editorLangId == sql && !grebe.duckdb.running",
          "group": "navigation@2"
        },
        {
          "command": "grebe.duckdb.cancel",
          "when": "editorLangId == sql && grebe.duckdb.running",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "grebe.duckdb.runRange",
          "when": "false"
        },
        {
          "command": "grebe.catalog.preview",
          "when": "false"
        },
        {
          "command": "grebe.catalog.columns",
          "when": "false"
        },
        {
          "command": "grebe.catalog.stats",
          "when": "false"
        },
        {
          "command": "grebe.catalog.count",
          "when": "false"
        },
        {
          "command": "grebe.catalog.copyName",
          "when": "false"
        },
        {
          "command": "grebe.catalog.insertName",
          "when": "false"
        },
        {
          "command": "grebe.catalog.closeFile",
          "when": "false"
        },
        {
          "command": "grebe.catalog.useAsDatabase",
          "when": "false"
        },
        {
          "command": "grebe.catalog.start",
          "when": "false"
        },
        {
          "command": "grebe.openInGrid",
          "when": "true"
        },
        {
          "command": "grebe.duckdb.cancel",
          "when": "grebe.duckdb.running"
        },
        {
          "command": "grebe.catalog.detach",
          "when": "false"
        },
        {
          "command": "grebe.catalog.reattach",
          "when": "false"
        },
        {
          "command": "grebe.catalog.reindex",
          "when": "false"
        },
        {
          "command": "grebe.catalog.forget",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "grebe.openInGrid",
          "when": "resourceExtname =~ /^\\.(parquet|csv|tsv)$/i || resourceFilename =~ /\\.(csv|tsv)\\.(gz|zst)$/i",
          "group": "navigation@9"
        },
        {
          "command": "grebe.inspect.columns",
          "when": "resourceExtname =~ /^\\.(parquet|csv|tsv|txt|json|jsonl|ndjson|gz|zst)$/i",
          "group": "7_grebe@1"
        },
        {
          "command": "grebe.inspect.stats",
          "when": "resourceExtname =~ /^\\.(parquet|csv|tsv|txt|json|jsonl|ndjson|gz|zst)$/i",
          "group": "7_grebe@2"
        },
        {
          "command": "grebe.inspect.preview",
          "when": "resourceExtname =~ /^\\.(parquet|csv|tsv|txt|json|jsonl|ndjson|gz|zst)$/i",
          "group": "7_grebe@3"
        },
        {
          "command": "grebe.inspect.parquet",
          "when": "resourceExtname =~ /^\\.parquet$/i",
          "group": "7_grebe@4"
        },
        {
          "command": "grebe.inspect.dialect",
          "when": "resourceExtname =~ /^\\.(csv|tsv|txt)$/i",
          "group": "7_grebe@5"
        },
        {
          "command": "grebe.catalog.browseFile",
          "when": "resourceExtname =~ /^\\.(duckdb|ddb|db)$/i",
          "group": "7_grebe@0"
        },
        {
          "command": "grebe.catalog.useAsDatabase",
          "when": "resourceExtname =~ /^\\.(duckdb|ddb|db)$/i",
          "group": "7_grebe@0"
        },
        {
          "command": "grebe.catalog.attach",
          "when": "resourceExtname =~ /^\\.(duckdb|ddb|db|sqlite|sqlite3)$/i",
          "group": "7_grebe@0"
        }
      ],
      "view/title": [
        {
          "command": "grebe.catalog.attach",
          "when": "view == grebe.catalog",
          "group": "navigation@0"
        },
        {
          "command": "grebe.catalog.browseFile",
          "when": "view == grebe.catalog",
          "group": "navigation@1"
        },
        {
          "command": "grebe.catalog.refresh",
          "when": "view == grebe.catalog",
          "group": "navigation@2"
        },
        {
          "command": "grebe.duckdb.restart",
          "when": "view == grebe.catalog",
          "group": "navigation@3"
        },
        {
          "command": "grebe.results.openInEditor",
          "when": "view == grebe.results",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "grebe.catalog.preview",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(table|view)$/",
          "group": "1_view@1"
        },
        {
          "command": "grebe.catalog.columns",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(table|view)$/",
          "group": "1_view@2"
        },
        {
          "command": "grebe.catalog.stats",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(table|view)$/",
          "group": "1_view@3"
        },
        {
          "command": "grebe.catalog.count",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(table|view)$/",
          "group": "1_view@4"
        },
        {
          "command": "grebe.catalog.copyName",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(table|view|macro|sequence|type)$/",
          "group": "2_name@1"
        },
        {
          "command": "grebe.catalog.insertName",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(table|view|macro|sequence|type)$/",
          "group": "2_name@2"
        },
        {
          "command": "grebe.catalog.closeFile",
          "when": "view == grebe.catalog && viewItem == grebe.fileRoot",
          "group": "inline"
        },
        {
          "command": "grebe.duckdb.restart",
          "when": "view == grebe.catalog && viewItem == grebe.sessionRoot",
          "group": "inline"
        },
        {
          "command": "grebe.catalog.detach",
          "when": "view == grebe.catalog && viewItem == grebe.attachedDb",
          "group": "inline"
        },
        {
          "command": "grebe.catalog.detach",
          "when": "view == grebe.catalog && viewItem == grebe.attachedDb",
          "group": "1_view@1"
        },
        {
          "command": "grebe.catalog.reindex",
          "when": "view == grebe.catalog && viewItem == grebe.attachedDb",
          "group": "1_view@2"
        },
        {
          "command": "grebe.catalog.reattach",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(lostDb|detachedDb)$/",
          "group": "inline@1"
        },
        {
          "command": "grebe.catalog.reattach",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(lostDb|detachedDb)$/",
          "group": "1_view@1"
        },
        {
          "command": "grebe.catalog.forget",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(lostDb|detachedDb)$/",
          "group": "inline@2"
        },
        {
          "command": "grebe.catalog.forget",
          "when": "view == grebe.catalog && viewItem =~ /^grebe\\.(lostDb|detachedDb)$/",
          "group": "1_view@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grebe-duckdb",
          "title": "DuckDB",
          "icon": "media/duckdb.svg"
        }
      ],
      "panel": [
        {
          "id": "grebe-results",
          "title": "DuckDB Results",
          "icon": "media/duckdb.svg"
        }
      ]
    },
    "views": {
      "grebe-duckdb": [
        {
          "id": "grebe.catalog",
          "name": "Catalog",
          "contextualTitle": "DuckDB"
        }
      ],
      "grebe-results": [
        {
          "type": "webview",
          "id": "grebe.results",
          "name": "Results",
          "contextualTitle": "DuckDB"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "grebe.dataFile",
        "displayName": "DuckDB Grid",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "grebe.delimitedFile",
        "displayName": "DuckDB Grid",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.csv.gz"
          },
          {
            "filenamePattern": "*.tsv.gz"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "keywords": [
    "duckdb",
    "sql",
    "linter",
    "formatter",
    "sql formatter",
    "sql linter",
    "parquet",
    "csv",
    "query",
    "results grid",
    "database",
    "postgres",
    "language server",
    "data engineering"
  ]
}
